pipeline {
    agent {
        kubernetes {
            yaml '''
apiVersion: v1
kind: Pod
metadata:
  labels:
    jenkins-pipeline: devops-build
spec:
  containers:
  - name: build-tools
    image: node:18-alpine
    command: ['cat']
    tty: true
  - name: aws-cli
    image: amazon/aws-cli:latest
    command: ['cat']
    tty: true
  - name: docker
    image: docker:24.0.7-cli
    command: ['cat']
    tty: true
    volumeMounts:
    - name: docker-sock
      mountPath: /var/run/docker.sock
  volumes:
  - name: docker-sock
    hostPath:
      path: /var/run/docker.sock
'''
        }
    }

    environment {
        AWS_REGION            = 'us-east-1'
        ECR_REPOSITORY        = 'your-app-repo' // استبدل باسم الـ ECR Repository
        AWS_ACCESS_KEY_ID     = credentials('AWS_ACCESS_KEY_ID')     // اسم الـ Credential في Jenkins
        AWS_SECRET_ACCESS_KEY = credentials('AWS_SECRET_ACCESS_KEY') // اسم الـ Credential في Jenkins
        IMAGE_TAG             = "${BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                container('build-tools') {
                    dir('app') {
                        sh 'npm ci || npm install'
                    }
                }
            }
        }

        stage('Get ECR Image Name') {
            steps {
                container('aws-cli') {
                    script {
                        def accountId = sh(
                            script: 'aws sts get-caller-identity --query Account --output text',
                            returnStdout: true
                        ).trim()

                        if (!accountId) {
                            error "Failed to retrieve AWS Account ID"
                        }

                        env.AWS_ACCOUNT_ID  = accountId
                        env.FULL_IMAGE_NAME = "${accountId}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPOSITORY}:${IMAGE_TAG}"
                        echo "Target ECR Image: ${env.FULL_IMAGE_NAME}"
                    }
                }
            }
        }

        stage('Build & Push Docker Image') {
            steps {
                script {
                    def loginCmd = container('aws-cli') {
                        sh(
                            script: "aws ecr get-login-password --region ${AWS_REGION}",
                            returnStdout: true
                        ).trim()
                    }

                    container('docker') {
                        sh """
                            echo "${loginCmd}" | docker login --username AWS --password-stdin ${env.AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
                            cd app
                            docker build -t ${env.FULL_IMAGE_NAME} .
                            docker push ${env.FULL_IMAGE_NAME}
                        """
                    }
                }
            }
        }
    }

    post {
        always {
            // 1. تنظيف node_modules لمنع خطأ الصلاحيات
            container('build-tools') {
                sh 'rm -rf app/node_modules'
            }
            // 2. استخدام الأمر المدمج لحذف الـ Workspace بدون حاجتك لـ workspace-cleanup plugin
            deleteDir()
        }
    }
}
